PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# SQL Server — formato de conexión Prisma
# Instancia local con autenticación de Windows:
# DATABASE_URL="sqlserver://localhost:1433;database=techledger;integratedSecurity=true;trustServerCertificate=true"
# Instancia local con usuario y contraseña:
# DATABASE_URL="sqlserver://localhost:1433;database=techledger;user=sa;password=TuPassword;trustServerCertificate=true"
DATABASE_URL="sqlserver://HOST:1433;database=techledger;user=USER;password=PASSWORD;trustServerCertificate=true"

# CORS
FRONTEND_URL=http://localhost:5173
