generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Company {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(150)
  ruc     String? @db.VarChar(11)
  address String? @db.VarChar(300)
  phone   String? @db.VarChar(20)
  email   String? @db.VarChar(150)
  logoUrl String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  products  Product[]
  customers Customer[]
  sales     Sale[]
  movements InventoryMovement[]
  categories Category[]
}

model User {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(100)
  email        String  @unique @db.VarChar(150)
  passwordHash String  @db.VarChar(255)
  role         String  @default("seller") @db.VarChar(20)
  isActive     Boolean @default(true)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]
  movements InventoryMovement[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  products Product[]

  // A category name is unique only inside its own company.
  @@unique([name, companyId])
  // Also unique as a pair so Product can enforce that its category belongs to the same company.
  @@unique([id, companyId])
  @@index([companyId, name])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  sku         String   @db.VarChar(50)
  description String?  @db.VarChar(1000)
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  minStock    Int      @default(0)
  imageUrl    String?  @db.VarChar(500)
  status      String   @default("active") @db.VarChar(20)

  categoryId Int?
  companyId  Int

  // Composite FK: a product can only reference a category from the same company.
  category Category? @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: SetNull, onUpdate: NoAction)
  company  Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]
  movements InventoryMovement[]

  @@unique([sku, companyId])
  @@index([companyId, status])
  @@index([companyId, categoryId])
}

model Customer {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(150)
  documentType   String    @db.VarChar(20)
  documentNumber String    @db.VarChar(20)
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(150)
  address        String?   @db.VarChar(300)
  totalPurchased Decimal   @default(0) @db.Decimal(12, 2)
  lastPurchaseAt DateTime?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@unique([documentNumber, companyId])
  @@index([companyId])
}

model Sale {
  id               Int     @id @default(autoincrement())
  receiptNumber    String  @unique @db.VarChar(30)
  status           String  @default("completed") @db.VarChar(20)
  subtotal         Decimal @db.Decimal(12, 2)
  igv              Decimal @db.Decimal(12, 2)
  total            Decimal @db.Decimal(12, 2)
  notes            String? @db.VarChar(500)
  customerName     String  @db.VarChar(150)
  customerDocument String  @db.VarChar(20)
  sellerName       String  @db.VarChar(100)

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sellerId   Int
  seller     User     @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     SaleItem[]
  movements InventoryMovement[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
}

model SaleItem {
  id          Int     @id @default(autoincrement())
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
  productName String  @db.VarChar(200)
  productSku  String  @db.VarChar(50)

  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model InventoryMovement {
  id            Int     @id @default(autoincrement())
  type          String  @db.VarChar(20)
  quantity      Int
  previousStock Int
  currentStock  Int
  reason        String? @db.VarChar(300)
  productName   String  @db.VarChar(200)
  productSku    String  @db.VarChar(50)
  userName      String  @db.VarChar(100)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saleId    Int?
  sale      Sale?   @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([productId])
}
