generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// EMPRESA
// ─────────────────────────────────────────────
model Company {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(150)
  ruc     String? @db.VarChar(11)
  address String? @db.VarChar(300)
  phone   String? @db.VarChar(20)
  email   String? @db.VarChar(150)
  logoUrl String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  products  Product[]
  customers Customer[]
  sales     Sale[]
  movements InventoryMovement[]
}

// ─────────────────────────────────────────────
// USUARIO
// ─────────────────────────────────────────────
model User {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(100)
  email        String  @unique @db.VarChar(150)
  passwordHash String  @db.VarChar(255)
  role         String  @default("seller") @db.VarChar(20) // admin | seller
  isActive     Boolean @default(true)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]
  movements InventoryMovement[]
}

// ─────────────────────────────────────────────
// CATEGORÍA
// ─────────────────────────────────────────────
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())

  products Product[]
}

// ─────────────────────────────────────────────
// PRODUCTO
// ─────────────────────────────────────────────
model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  sku         String   @db.VarChar(50)
  description String?  @db.VarChar(1000)
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  minStock    Int      @default(0)
  imageUrl    String?  @db.VarChar(500)
  status      String   @default("active") @db.VarChar(20) // active | inactive

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]
  movements InventoryMovement[]

  @@unique([sku, companyId])
  @@index([companyId, status])
}

// ─────────────────────────────────────────────
// CLIENTE
// ─────────────────────────────────────────────
model Customer {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(150)
  documentType   String    @db.VarChar(20) // DNI | RUC | CE | PASSPORT
  documentNumber String    @db.VarChar(20)
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(150)
  address        String?   @db.VarChar(300)
  totalPurchased Decimal   @default(0) @db.Decimal(12, 2)
  lastPurchaseAt DateTime?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@unique([documentNumber, companyId])
  @@index([companyId])
}

// ─────────────────────────────────────────────
// VENTA
// ─────────────────────────────────────────────
model Sale {
  id            Int     @id @default(autoincrement())
  receiptNumber String  @unique @db.VarChar(30)
  status        String  @default("completed") @db.VarChar(20) // pending | completed | cancelled
  subtotal      Decimal @db.Decimal(12, 2)
  igv           Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  notes         String? @db.VarChar(500)

  // Snapshot del cliente al momento de la venta
  customerName     String @db.VarChar(150)
  customerDocument String @db.VarChar(20)

  // Snapshot del vendedor al momento de la venta
  sellerName String @db.VarChar(100)

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  sellerId Int
  seller   User @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     SaleItem[]
  movements InventoryMovement[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
}

// ─────────────────────────────────────────────
// ÍTEM DE VENTA
// ─────────────────────────────────────────────
model SaleItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  // Snapshot del producto al momento de la venta
  productName String @db.VarChar(200)
  productSku  String @db.VarChar(50)

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─────────────────────────────────────────────
// MOVIMIENTO DE INVENTARIO
// ─────────────────────────────────────────────
model InventoryMovement {
  id            Int     @id @default(autoincrement())
  type          String  @db.VarChar(20) // entry | sale | return | adjustment
  quantity      Int     // positivo = entrada, negativo = salida
  previousStock Int
  currentStock  Int
  reason        String? @db.VarChar(300)

  // Snapshot del producto al momento del movimiento
  productName String @db.VarChar(200)
  productSku  String @db.VarChar(50)

  // Snapshot del usuario que lo ejecutó
  userName String @db.VarChar(100)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // null para movimientos manuales, ID de venta para los originados por una venta
  saleId Int?
  sale   Sale? @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([productId])
}
